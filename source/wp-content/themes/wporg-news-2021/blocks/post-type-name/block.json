{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "wporg/post-type-name",
	"title": "Post Type Name",
	"category": "widgets",
	"description": "Add the post type name.",
	"supports": {
		"html": false
	},
	"attributes": {
		"tagName": {
			"type": "string",
			"enum": [ "span", "div", "p", "h1", "h2", "h3", "h4", "h5", "h6" ],
			"default": "span"
		},
		"isLink": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": [ "postId" ],
	"textdomain": "wporg"
}
