{
	"name": "wporg-news-2021-theme",
	"version": "1.1.0",
	"description": "A Full Site Editing theme for w.org/news, with a jazz-inspired design.",
	"author": "WordPress.org",
	"license": "GPL-2.0-or-later",
	"private": true,
	"devDependencies": {
		"@wordpress/base-styles": "^14.0.0",
		"@wordpress/browserslist-config": "^7.0.0",
		"@wordpress/scripts": "^37.0.0",
		"@wordpress/stylelint-config": "^27.0.0",
		"webpack-remove-empty-scripts": "^1.1.1"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:css": "wp-scripts lint-style 'sass/**/*.scss'",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"stylelint": {
		"extends": "@wordpress/stylelint-config/scss",
		"rules": {
			"no-descending-specificity": null,
			"no-duplicate-selectors": null,
			"rule-empty-line-before": [
				"always-multi-line",
				{
					"except": [
						"first-nested",
						"after-single-line-comment"
					]
				}
			],
			"selector-class-pattern": null,
			"value-keyword-case": [
				"lower",
				{
					"camelCaseSvgKeywords": true
				}
			]
		}
	}
}
